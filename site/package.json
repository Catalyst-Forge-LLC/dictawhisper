{
	"name": "dictawhisper-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"docs:build": "node scripts/build-docs.mjs",
		"dev": "pnpm docs:build && node ../scripts/ensure-lease.mjs dictawhisper-site 5186 && filepress dev --host 0.0.0.0",
		"build": "pnpm docs:build && filepress build",
		"preview": "filepress preview",
		"check": "filepress check",
		"ship": "pnpm build && wrangler pages deploy build --project-name=dictawhisper",
		"deploy": "pnpm ship"
	},
	"devDependencies": {
		"getfilepress": "^0.1.28",
		"wrangler": "^4.28.0"
	},
	"pnpm": {
		"overrides": {
			"js-yaml": "3.15.2",
			"sharp": "0.35.4"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"getfilepress",
			"workerd"
		]
	}
}

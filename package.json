{
  "name": "dictawhisper",
  "version": "0.1.3",
  "private": false,
  "description": "Local voice journal. Record or drop audio, transcribe with faster-whisper, keep the .json next to the file.",
  "homepage": "https://dictawhisper.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Catalyst-Forge-LLC/dictawhisper.git"
  },
  "bugs": {
    "url": "https://github.com/Catalyst-Forge-LLC/dictawhisper/issues"
  },
  "author": "Catalyst Forge LLC",
  "keywords": [
    "whisper",
    "faster-whisper",
    "transcription",
    "voice-journal",
    "local",
    "ollama",
    "ollanet"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "dictawhisper": "bin/dictawhisper.js"
  },
  "files": [
    "bin",
    "src",
    "scripts/transcribe_faster_whisper.py",
    "dist/ui",
    "config.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "cli": "node --experimental-strip-types src/cli.ts",
    "dev": "localslip claim dictawhisper --port 7777 && localslip claim dictawhisper-api --port 8008 && node --experimental-strip-types src/dev.ts",
    "serve": "localslip claim dictawhisper --port 7777 && localslip claim dictawhisper-api --port 8008 && node --experimental-strip-types src/dev.ts",
    "turbo": "WHISPER_MODEL=turbo node --experimental-strip-types src/server.ts",
    "ui": "pnpm --dir client dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "doctor": "node --experimental-strip-types src/doctor.ts",
    "mcp": "node --experimental-strip-types src/mcp.ts",
    "retranscribe": "node --experimental-strip-types scripts/retranscribe.ts",
    "asr:compare": "node --experimental-strip-types scripts/run-compare-asr.ts",
    "audio:probe": "node --experimental-strip-types scripts/probe-pending.ts",
    "journal:index": "node --experimental-strip-types scripts/journal-index.ts",
    "inbox:organize": "node scripts/inbox-organize.mjs",
    "inbox:file-live": "node scripts/inbox-file-live.mjs",
    "inbox:convert": "node scripts/inbox-convert-non-mp3.mjs",
    "inbox:stamp-mtime": "node scripts/inbox-stamp-mtime.mjs",
    "inbox:fix-mtime": "node scripts/inbox-fix-mtime.mjs",
    "site:dev": "localslip claim dictawhisper-site --port 5186 && pnpm --dir site dev",
    "site:build": "pnpm --dir site build",
    "site:deploy": "pnpm --dir site run ship",
    "ship": "pnpm --dir site run ship",
    "prepublishOnly": "node scripts/publish-gate.mjs && pnpm test && pnpm typecheck && pnpm --dir client build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@8.14.1",
  "pnpm": {
    "overrides": {
      "cookie@<0.7.0": "1.1.1",
      "fast-uri": "3.1.7",
      "hono": "4.13.7",
      "qs": "6.16.0",
      "launch-editor": "2.14.1"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "async": "^3.2.6",
    "chokidar": "^4.0.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.0",
    "fuse.js": "^7.5.0",
    "multer": "^2.4.0",
    "ollanet": "^0.6.5",
    "socket.io": "^4.8.1",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/async": "^3.2.25",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.6.2",
    "smellcheck": "^0.3.4",
    "typescript": "^5.9.3"
  }
}
